{
  "description": "Inject the standing dispatch rules at session start, and deny Agent/Workflow dispatches that name no model tier (or no workflow effort) when they would silently inherit an opus or fable session model",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-tier-gate.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
